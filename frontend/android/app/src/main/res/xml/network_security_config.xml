<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted only to the loopback addresses a development
  machine uses, and denied everywhere else.

  The API key travels in a header on every request, so allowing cleartext to an
  arbitrary host would expose it to anything on the network path. Restricting the
  exemption to 10.0.2.2 (the host, as seen from the emulator) and localhost keeps
  `flutter run` working against a local server without weakening the release
  build. A real deployment is expected to be HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- The host machine, as the emulator reaches it. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- The host machine, as an emulator or device on loopback reaches it. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
