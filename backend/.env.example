# Notes API — configuration reference
#
# Copy to .env and edit:  cp .env.example .env
# .env is gitignored, so your real secrets never reach a commit.
#
# Scope, and the part that surprises people:
#   * `docker compose up` reads .env automatically for the ${VAR:-default}
#     substitutions in docker-compose.yml. Nothing else does.
#   * `go run ./cmd/api` does NOT read this file. The application only ever
#     calls os.Getenv, so for a host run either `set -a; . ./.env; set +a`
#     or export the variables in your shell.
#   * CI has its own env block in .github/workflows/ci.yml and ignores .env.

# ---------------------------------------------------------------- transports
# Listen address of the REST API.
HTTP_PORT=:8080
# Listen address of the gRPC API.
GRPC_PORT=:50051

# ------------------------------------------------------------------- database
# The credentials below feed BOTH the postgres container (as POSTGRES_*) and
# the application, so they are defined once. DB_PORT only moves the published
# host port: inside the compose network the app always reaches the peer on the
# image's own 5432, by service name.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=notes_db
# Changing DB_USER/DB_PASS/DB_NAME after the first `up` has no effect: the
# existing pgdata volume keeps the credentials it was initialised with. Reset
# with `docker compose down -v` (this deletes the data).

# --------------------------------------------------------------------- auth
# REQUIRED. Comma-separated list of accepted API keys. Sent as the X-API-Key
# header on REST, and as "x-api-key" metadata on gRPC. /healthz and /metrics
# are exempt, so probes and scrapes
# need no credential. An empty entry is ignored, which prevents a trailing
# comma from turning into a key that authenticates everyone.
API_KEYS=dev-secret-key-change-me
# Escape hatch for local experiments only. The service refuses to start with
# an empty API_KEYS unless this is true, so a deployment can never come up
# silently unauthenticated.
ALLOW_INSECURE_AUTH=false

# -------------------------------------------------------------- rate limit
# Per-process, per-client-address limiter. With N replicas the effective limit
# is N times the configured value, since each process keeps its own buckets.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# X-Forwarded-For is deliberately ignored when identifying a client: it is
# client-controlled, so honouring it would let anyone mint unlimited buckets
# or evade the limit entirely.

# ---------------------------------------------------------------------- CORS
# Browser origins allowed to read responses. Needed only by web clients: a
# Flutter web build runs on its own origin, and without these headers the
# browser hides the response from the application. iOS and Android are not
# browsers and ignore CORS entirely.
#
# The default is the wildcard, which is convenient because `flutter run -d
# chrome` picks a random dev-server port. That is too loose for a deployment:
# pin the origins that actually serve your client, for example
#   CORS_ALLOWED_ORIGINS=https://notes.example.com
# Each entry must be a bare origin (scheme, host, optional port) — a trailing
# slash or a path is rejected at startup rather than silently never matching.
CORS_ALLOWED_ORIGINS=*

# ------------------------------------------------------------------ tracing
# One of: stdout, otlp, none.
TRACE_EXPORTER=stdout
# gRPC endpoint of the collector, without a scheme. See otel-collector.yaml.
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# Fraction of traces to record, within [0,1]. Sits inside a ParentBased
# sampler, so a trace started upstream is never downgraded or double-counted.
OTEL_TRACES_SAMPLER_ARG=1.0

# ----------------------------------------------------------------- lifecycle
# Budget for in-flight requests to finish on SIGTERM/SIGINT. The same budget
# covers both transports, so a slow HTTP drain leaves less room for gRPC.
# Must be positive: anything else expires the context before the signal is
# handled and turns a graceful shutdown into an immediate kill.
SHUTDOWN_TIMEOUT=10s
