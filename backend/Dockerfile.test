# Test image: full Go toolchain + sources, used to run the test suite
# against a throwaway Postgres.
FROM golang:1.26-alpine

# ca-certificates for module downloads; postgresql-client for pg_isready
RUN apk add --no-cache ca-certificates postgresql-client

WORKDIR /src

# Copy go mod files first to leverage Docker cache
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Fail fast if anything does not compile in the image environment
RUN go build ./... && go vet ./...

# Integration tests carry the "integration" build tag and are excluded by
# default; ./... is the package pattern, not a single file.
CMD ["go", "test", "-tags=integration", "-v", "-race", "./..."]
